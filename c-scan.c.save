#include <stdio.h>
#include <stdlib.h>
int main() {
int head, req[20], n, i, j, seektime = 0, max, flag = 0, seq[20], c = 0, temp;
printf("Enter the number of Cylinders: ");
scanf("%d", &max);
printf("Enter the Number of Requests: ");
scanf("%d", &n);
printf("Enter the requests: ");
for (i = 0; i < n; i++)
scanf("%d", &req[i]);
for (i = 0; i < n; i++) {
if (req[i] >= max) {
flag = 1;
break;}}
if (flag == 1) {
printf("Process cannot complete\n");
return 0;}
for (i = 0; i < n - 1; i++) {
for (j = 0; j < n - i - 1; j++) {
if (req[j] > req[j + 1]) {
temp = req[j];
req[j] = req[j + 1];
req[j + 1] = temp;}}}
printf("Enter the current position of the head: ");
scanf("%d", &head);
int index = 0;
while (index < n && req[index] < head)
index++;
for (i = index; i < n; i++) {
seektime += abs(req[i] - head);
head = req[i];
seq[c++] = req[i];}
seektime += (max - 1 - head);
head = max - 1;
seektime += head;
head = 0;
for (i = 0; i < index; i++) {
seektime += abs(req[i] - head);
head = req[i];
seq[c++] = req[i];}
printf("Seektime = %d\n", seektime);
printf("Seek Sequence: ");
for (i = 0; i < c; i++)
printf("%d -> ", seq[i]);
printf("\n");
return 0;}

